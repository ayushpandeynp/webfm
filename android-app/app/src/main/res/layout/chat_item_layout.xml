<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- User's question (aligns to the right) -->
    <LinearLayout
        android:id="@+id/userMessageLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/user_message_background"
        android:gravity="end"
        android:maxWidth="0dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.65">

        <TextView
            android:id="@+id/chat_question_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User's question"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/chat_timestamp_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="12:00 PM"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bot's response (aligns to the left) -->
    <LinearLayout
        android:id="@+id/responseMessageLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/response_message_background"
        android:gravity="start"
        android:maxWidth="0dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.65">

        <TextView
            android:id="@+id/chat_answer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bot's answer"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/chat_timestamp_bot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="12:01 PM"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
